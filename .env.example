# LLM Configuration (optional — app works without LLM)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai-compatible

# Authentication (OIDC / Keycloak)
OIDC_DISCOVERY_URL=http://localhost:8080/realms/security-ops/.well-known/openid-configuration
OIDC_CLIENT_ID=security-ops
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Session Security
JWT_SECRET=

# Keycloak Admin (for local development only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Database (SQLite — adjust for PostgreSQL in production)
DATABASE_URL=sqlite:///./data/security_ops.db

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Local demo mode (localhost only — refused in production)
# DEMO_MODE=true
